{
  "multipart": [
    {
      "when": {
        "powered": "false"
      },
      "apply": {
        "model": "scc:block/toggle_bus"
      }
    },
    {
      "when": {
        "powered": "true"
      },
      "apply": {
        "model": "scc:block/toggle_bus_open"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_3"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_3",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_3",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_3",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_3",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_3",
        "x": 90
      }
    }
  ]
}
