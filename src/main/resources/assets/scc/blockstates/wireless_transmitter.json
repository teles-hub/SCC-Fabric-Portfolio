{
  "multipart": [
    {
      "when": {
        "active": "false"
      },
      "apply": {
        "model": "scc:block/wireless_transmitter"
      }
    },
    {
      "when": {
        "active": "true"
      },
      "apply": {
        "model": "scc:block/wireless_transmitter_active"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_5"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_5",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_5",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_5",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_5",
        "x": 270
      }
    }
  ]
}
