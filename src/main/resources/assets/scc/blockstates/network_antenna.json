{
  "multipart": [
    {
      "apply": {
        "model": "scc:block/network_antenna"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_6_4"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_6_4",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_6_4",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "scc:block/cable_port_6_4",
        "y": 270
      }
    }
  ]
}
